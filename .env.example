# Environment selection — picks which configs/<env>.yaml overlay is layered
# on top of configs/base.yaml. See configs/ for the non-secret settings
# (port, log level, timeouts, cookie policy, token TTLs).
APP_ENV=dev

# CORS Configuration
# Comma-separated list of allowed origins
# For development, you might use: http://localhost:3000,http://localhost:5173,http://localhost:8080
# For production, use your actual frontend domains: https://yourdomain.com,https://www.yourdomain.com
APP_ALLOWED_ORIGINS=http://localhost:5173

# Secrets — these are never stored in configs/*.yaml, only supplied via
# environment variables / this .env file.
APP_DATABASE_URL=postgres://user:password@localhost/rms_db?sslmode=disable
APP_POSTGRES_USER=rms_user
APP_POSTGRES_PASSWORD=rms_password
APP_POSTGRES_DB=rms_db
APP_JWT_SECRET=some_secret_key_for_jwt_signing

# Docker configuration - DEV only
POSTGRES_DATA_PATH=your/local/path/to/postgres/data

# Cloudflare R2 (object storage for media uploads)
APP_R2_ACCOUNT_ID=your_r2_account_id
APP_R2_ACCESS_KEY_ID=your_r2_access_key_id
APP_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
APP_R2_BUCKET_NAME=your_r2_bucket_name
# Optional — base URL objects are served from (custom domain or R2.dev
# subdomain). Leave empty if objects are not served publicly.
APP_R2_PUBLIC_BASE_URL=
