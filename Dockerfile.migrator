# --- Stage 1: Build ---
FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build the migration runner (adjust path to your migration main file)
RUN CGO_ENABLED=0 GOOS=linux go build -o migrator ./cmd/migrate

# --- Stage 2: Runtime ---
FROM alpine:latest
RUN apk --no-cache add ca-certificates

WORKDIR /home/appuser/

COPY --from=builder /app/migrator .

# This image is only ever deployed to production, so we deliberately copy
# only base.yaml + prod.yaml (never dev.yaml) — that way a misconfigured
# APP_ENV can't accidentally pull in dev overrides at runtime. If a
# QA/staging tier is introduced, this needs to change
COPY --from=builder /app/configs/base.yaml /app/configs/prod.yaml ./configs/

# Use a non-root user
RUN adduser -D appuser
USER appuser

# Standard command to run migrations
ENTRYPOINT ["./migrator"]