# --- Stage 1: Build ---
FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o server ./cmd/server

# --- Stage 2: Runtime ---
FROM alpine:latest
RUN apk --no-cache add ca-certificates

# Create a non-privileged user for security
RUN adduser -D appuser
USER appuser

WORKDIR /home/appuser/

COPY --from=builder /app/server .

# This image is only ever deployed to production, so we deliberately copy
# only base.yaml + prod.yaml (never dev.yaml) — that way a misconfigured
# APP_ENV can't accidentally pull in dev overrides (e.g. insecure cookies)
# at runtime. If a QA/staging tier is introduced, this needs to change
COPY --from=builder /app/configs/base.yaml /app/configs/prod.yaml ./configs/

EXPOSE 8080

CMD ["./server"]